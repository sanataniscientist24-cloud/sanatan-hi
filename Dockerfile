# ─────────────────────────────────────────────────────────────────────────────
# SANATAN HI [ HUMAN INTELLIGENCE ] — production image for Coolify / Docker
#
# Multi-stage build on Bun. Produces a slim, non-root, self-contained image
# that runs the Next.js standalone server (output: "standalone").
#
#   Stage 1 — deps      : install node_modules (cached layer)
#   Stage 2 — builder   : next build → .next/standalone (self-contained)
#   Stage 3 — runner    : minimal runtime, non-root, healthcheck, entrypoint
#
# Build:   docker build -t sanatan-hi .
# Run:     docker run -p 3000:3000 -e ZAI_API_KEY=... sanatan-hi
#
# Coolify detects this Dockerfile automatically. Set env vars
# (ZAI_API_KEY or ZAI_CONFIG_JSON) in the Coolify resource settings.
# ─────────────────────────────────────────────────────────────────────────────

# syntax=docker/dockerfile:1.7

# ── Stage 1: install dependencies ────────────────────────────────────────────
FROM oven/bun:1.3-debian AS deps
WORKDIR /app

# Copy lockfile + manifests first for maximum layer caching
COPY package.json bun.lock ./
COPY prisma ./prisma

# --frozen-lockfile guarantees reproducible installs (CI-grade)
RUN bun install --frozen-lockfile

# ── Stage 2: build the standalone server ─────────────────────────────────────
FROM oven/bun:1.3-debian AS builder
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
# IMPORTANT: do NOT set NEXT_OUTPUT=export here — that mode strips the API
# routes (server voice/LLM). We want the standalone Node server.
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# next build produces .next/standalone/ ; the build script then copies
# .next/static + public/ INTO standalone so it is fully self-contained.
RUN bun run build

# Prisma client is generated by the postinstall hook, but regenerate
# explicitly in case the lockfile step skipped it (harmless if unused).
RUN bunx prisma generate || true

# ── Stage 3: minimal runtime image ───────────────────────────────────────────
FROM oven/bun:1.3-debian AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Coolify injects PORT via env; the standalone server reads process.env.PORT
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
# SQLite lives on a persistent volume (the app is stateless at runtime today,
# but this keeps the door open for future DB-backed features)
ENV DATABASE_URL=file:/app/db/custom.db

# Create an unprivileged user; the server never needs root
RUN groupadd --system --gid 1001 app \
 && useradd  --system --uid 1001 --gid app --no-create-home --home-dir /home/app app \
 && mkdir -p /app/db /home/app \
 && chown -R app:app /app /home/app

# Standalone server.js is self-contained (static + public already copied in
# by the build script), but we copy static/public explicitly too so the image
# stays correct even if that script ever changes.
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static
COPY --from=builder --chown=app:app /app/public ./public
COPY --from=builder --chown=app:app /app/prisma ./prisma
COPY --chown=app:app scripts/docker-entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

USER app

EXPOSE 3000

# Liveness probe — hits /api/health (added in this same change-set).
# Uses bun's built-in fetch, so no curl/wget needed in the image.
HEALTHCHECK --interval=30s --timeout=10s --start-period=25s --retries=3 \
  CMD bun -e "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Entrypoint materializes .z-ai-config from env vars, then execs the CMD.
ENTRYPOINT ["./entrypoint.sh"]
CMD ["bun", "server.js"]
